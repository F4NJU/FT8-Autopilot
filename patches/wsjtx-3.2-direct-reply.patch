-// Takes a decoded CQ line and sets it up for reply
+bool MainWindow::isNetworkReplyAllowed (DecodedText const& message, QString const& mode,
+                                        bool low_confidence) const
+{
+  auto recipient = message.call ();
+  auto const is_cq_or_qrz = recipient == "CQ" || recipient == "QRZ"
+    || recipient == "CQDX" || recipient.startsWith ("CQ ");
+  if (is_cq_or_qrz)
+    {
+      return true;              // Preserve the documented Reply behavior.
+    }
+
+  // Direct Reply is deliberately limited to native structured FT8/FT4
+  // messages whose recipient is this configured WSJT-X station.
+  recipient.remove ('<').remove ('>');
+  auto const addressed_to_me = Radio::is_callsign (recipient)
+    && (recipient == m_config.my_callsign ()
+        || recipient == m_baseCall
+        || Radio::base_callsign (recipient) == m_baseCall);
+  return !low_confidence
+    && (mode == "~" || mode == "+")
+    && message.isStandardMessage ()
+    && addressed_to_me;
+}
